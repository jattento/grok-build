#!/usr/bin/env bash
# Launch the locally built, overlay-enabled grok binary.
#
#   grk [args...]              run the last release build
#   grk --rebuild [args...]    rebuild first, then run
#   GRK_REBUILD=1 grk [args]   same, for scripts
#
# It never rebuilds on its own: upstream's build.rs points rerun-if-changed at
# a path that does not exist inside the crate, so cargo re-runs it and relinks
# the binary on every invocation (~17s even with no changes). Instead we warn
# when the binary is older than the sources.
set -euo pipefail

# Resolve this script through any symlinks (macOS has no `readlink -f`).
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
repo_root=$(cd "$(dirname "$self")/../.." && pwd)
bin=$repo_root/target/release/xai-grok-pager

rebuild=0
case ${GRK_REBUILD:-} in
  '' | 0 | false | off | no) ;;
  *) rebuild=1 ;;
esac
# Only honored in first position, so it can never shadow a future upstream flag.
if [ "${1:-}" = "--rebuild" ]; then
  rebuild=1
  shift
fi

if [ ! -x "$bin" ]; then
  echo "grk: no release binary yet, building it (this takes a while)..." >&2
  rebuild=1
fi

if [ "$rebuild" -eq 1 ]; then
  (cd "$repo_root" && cargo build -p xai-grok-pager-bin --release)
elif stale=$(cd "$repo_root" && find overlay crates -type f \
  \( -name '*.rs' -o -name 'Cargo.toml' \) -newer "$bin" -print -quit) &&
  [ -n "$stale" ]; then
  echo "grk: binario desactualizado ($stale), corré 'grk --rebuild'" >&2
fi

# No cd: grok must see the caller's working directory.
# Herdr identifies agents by the foreground process, which here is
# `xai-grok-pager` rather than the `grok` its manifest expects. This hint is the
# documented way to point a wrapped process at an existing agent manifest, and
# it is scoped to this process instead of the whole shell.
export HERDR_AGENT="${HERDR_AGENT:-grok}"

exec "$bin" "$@"
